<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- [Fuki] Metro HUD: tmavé pozadí, dialogy ve stejném stylu (ostré rohy, žlutý akcent) -->
    <style name="Fuki" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/fuki_pozadi</item>
        <item name="android:statusBarColor">@color/fuki_pozadi</item>
        <item name="android:navigationBarColor">@color/fuki_pozadi</item>
        <item name="android:colorAccent">@color/fuki_zluta</item>
        <item name="android:alertDialogTheme">@style/Fuki.Dialog</item>
    </style>

    <style name="Fuki.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_pozadi</item>
        <item name="android:colorBackground">@color/fuki_karta</item>
        <item name="android:colorAccent">@color/fuki_zluta</item>
        <item name="android:textColorPrimary">@color/fuki_text</item>
        <item name="android:textColorSecondary">@color/fuki_text2</item>
        <item name="android:textColorAlertDialogListItem">@color/fuki_text</item>
        <item name="android:fontFamily">@font/jakarta_regular</item>
        <item name="android:buttonBarButtonStyle">@style/Fuki.DialogTlacitko</item>
    </style>

    <style name="Fuki.DialogTlacitko" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/fuki_zluta</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/dialog_tlacitko</item>
    </style>
</resources>
